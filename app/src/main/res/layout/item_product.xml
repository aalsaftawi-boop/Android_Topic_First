<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:text="priduct id"
        android:layout_margin="20dp"
        app:layout_constraintEnd_toStartOf="@id/productnameTv"
        android:id="@+id/productidTv"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        app:layout_constraintStart_toEndOf="@id/productidTv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="priduct name"
        android:layout_margin="20dp"
        android:id="@+id/productnameTv"/>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/productidTv"
        app:layout_constraintStart_toStartOf="@id/productidTv"
        app:layout_constraintEnd_toEndOf="@id/productidTv"
        android:text="priduct price"
        android:layout_margin="20dp"
        android:id="@+id/productpriceTv"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="28sp"
        app:layout_constraintTop_toBottomOf="@id/productnameTv"
        app:layout_constraintStart_toStartOf="@id/productnameTv"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="priduct quantity"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="15dp"
        android:id="@+id/productquantityTv"/>



</androidx.constraintlayout.widget.ConstraintLayout>